---
// Hero principal — titular + brújula animada + card destacada
---

<section class="hero" id="top">
  <div class="wrap hero-inner">
    <div>
      <div class="hero-tag">
        <span class="dot"></span>
        34.ª Feria de Software USM · 13 de noviembre
      </div>
      <h1>
        <em>Simulamos</em> el futuro del tráfico<br />
         antes de aplicar <em>soluciones</em>.
      </h1>
      <p>
        Un gemelo digital del tráfico en el acceso a San Antonio, entrenado con
        redes neuronales de grafos y aprendizaje por refuerzo, para probar
        políticas de semaforización sin arriesgar una sola maniobra en terreno.
      </p>
      <div class="hero-ctas">
        <a href="#demo" class="btn-primary">Ver la simulación</a>
      </div>
    </div>

    <div class="hero-visual">
      <div class="lidar-sweep" aria-hidden="true">
        <span class="ring"></span>
        <span class="ring"></span>
        <span class="ring"></span>
      </div>
      <img
        class="compass-big"
        src="/images/logo/logo_light_sinfondo.png"
        alt=""
        aria-hidden="true"
        width="420"
        height="420"
        draggable="false"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    /* Gradient: arriba más denso para que el h1 se lea claro contra
       el biome, y hacia el bottom afloja para que el paisaje se vea
       nítido (matcheando la nitidez de la sección Desafio que sigue). */
    background: linear-gradient(
      180deg,
      rgba(4, 69, 89, 0.78) 0%,
      rgba(4, 69, 89, 0.68) 40%,
      rgba(4, 69, 89, 0.55) 100%
    );
    color: var(--cream);
    position: relative;
    /* overflow visible en Y para que las ondas de click (ripples) puedan
       extenderse desde la brújula hacia abajo dentro de Desafio.
       Se mantiene clip horizontal para no generar scroll lateral. */
    overflow-x: clip;
    overflow-y: visible;
    /* z-index elevado para que esas ondas rendericen por encima del
       gradiente de Desafio. */
    z-index: 4;
    padding: 100px 0 120px;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 2;
  }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--cyan);
    border: 1px solid rgba(97, 225, 230, 0.4);
    border-radius: 100px;
    padding: 8px 16px;
    margin-bottom: 28px;
  }
  .hero-tag .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--lime);
  }
  h1 {
    font-family: var(--font-title);
    font-weight: 700;
    font-size: 56px;
    line-height: 1.08;
    letter-spacing: -0.5px;
    max-width: 560px;
  }
  h1 em {
    font-style: italic;
    color: var(--cyan);
  }
  p {
    margin-top: 24px;
    font-size: 17px;
    color: rgba(255, 248, 234, 0.78);
    max-width: 460px;
  }
  .hero-ctas {
    display: flex;
    gap: 16px;
    margin-top: 36px;
    align-items: center;
  }
  .btn-primary {
    background: var(--lime);
    color: var(--navy-deep);
    font-weight: 700;
    font-size: 15px;
    padding: 15px 28px;
    border-radius: 100px;
  }
  .btn-ghost {
    color: var(--cream);
    font-weight: 600;
    font-size: 15px;
    padding: 15px 10px;
    border-bottom: 1px solid rgba(255, 248, 234, 0.4);
  }
  .hero-visual {
    position: relative;
    height: 420px;
    /* Eje Y compartido: brújula y lidar-sweep pivotan aquí. */
    --compass-cy: 50%;
  }
  .compass-big {
    position: absolute;
    top: var(--compass-cy);
    left: 50%;
    transform: translate(-50%, -50%);
    width: 420px;
    height: 420px;
    opacity: 0.6;
    animation: spin 60s linear infinite;
    z-index: 1;
    /* Logo oficial cuadrado — object-fit para preservar proporciones */
    object-fit: contain;
    user-select: none;
    -webkit-user-drag: none;
    pointer-events: none;
  }

  /* ---------- LIDAR SWEEP ---------- */
  /* Arcos cyan que se expanden desde el centro como pulsos de radar LiDAR.
     Se aceleran cuando el usuario scrollea (body.is-scrolling toggled desde
     ScrollRoad.astro). */
  .lidar-sweep {
    position: absolute;
    top: var(--compass-cy);
    left: 50%;
    width: 420px;
    height: 420px;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 0;
  }
  .lidar-sweep .ring {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    border: 1.5px solid rgba(97, 225, 230, 0.55);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 0;
    animation: lidar-pulse 5s ease-out infinite;
  }
  .lidar-sweep .ring:nth-child(1) {
    animation-delay: 0s;
  }
  .lidar-sweep .ring:nth-child(2) {
    animation-delay: 1.6s;
  }
  .lidar-sweep .ring:nth-child(3) {
    animation-delay: 3.2s;
  }
  @keyframes lidar-pulse {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.3);
    }
    15% {
      opacity: 0.7;
    }
    100% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.35);
    }
  }
  /* Cuando el usuario scrollea, los pulsos aceleran (efecto radar activo) */
  :global(body.is-scrolling) .lidar-sweep .ring {
    animation-duration: 1.8s;
  }

  @media (prefers-reduced-motion: reduce) {
    .lidar-sweep .ring {
      animation: none;
      opacity: 0;
    }
    .compass-big {
      animation: none;
    }
  }

  /* ---------- CLICK RIPPLES ---------- */
  /* Impacto tipo agua: flash brillante + 3 ondas concéntricas escalonadas.
     Se crean dinámicamente por JS y se auto-eliminan al terminar. */
  .ripple {
    position: absolute;
    width: 30px;
    height: 30px;
    border: 3px solid var(--cyan);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    will-change: transform, opacity, border-width;
    animation: ripple-expand 1300ms cubic-bezier(0.15, 0.55, 0.3, 1) forwards;
    z-index: 4;
    box-shadow: 0 0 8px rgba(97, 225, 230, 0.4);
  }
  .ripple-flash {
    position: absolute;
    width: 80px;
    height: 80px;
    background: radial-gradient(
      circle,
      rgba(97, 225, 230, 0.85) 0%,
      rgba(97, 225, 230, 0.3) 40%,
      rgba(97, 225, 230, 0) 70%
    );
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    pointer-events: none;
    will-change: transform, opacity;
    animation: ripple-flash 550ms ease-out forwards;
    z-index: 4;
  }
  @keyframes ripple-expand {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
      border-width: 3px;
    }
    10% {
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) scale(10);
      opacity: 0;
      border-width: 0.5px;
    }
  }
  @keyframes ripple-flash {
    0% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 1;
    }
    100% {
      transform: translate(-50%, -50%) scale(2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ripple,
    .ripple-flash {
      animation: none;
      display: none;
    }
  }
  @keyframes spin {
    from {
      transform: translate(-50%, -50%) rotate(0deg);
    }
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }
  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }
    h1 {
      font-size: 38px;
    }
    /* Alto suficiente para la brújula sola en mobile */
    .hero-visual {
      height: 320px;
      margin-top: 20px;
      --compass-cy: 50%;
    }
    .compass-big,
    .lidar-sweep {
      width: 200px;
      height: 200px;
    }
  }
</style>

<script>
  // Ripples al hacer click sobre la brújula — impacto de agua con
  // múltiples ondas concéntricas.
  const heroVisual = document.querySelector<HTMLElement>('.hero-visual');

  if (heroVisual) {
    const spawnRipple = (x: number, y: number, delay: number, klass: string) => {
      window.setTimeout(() => {
        const el = document.createElement('span');
        el.className = klass;
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
        heroVisual.appendChild(el);
        el.addEventListener('animationend', () => el.remove(), { once: true });
      }, delay);
    };

    heroVisual.addEventListener('click', (e) => {
      const rect = heroVisual.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      // Flash inicial: halo brillante en el punto de impacto
      spawnRipple(x, y, 0, 'ripple-flash');
      // Tres ondas concéntricas escalonadas — efecto "impacto en agua"
      spawnRipple(x, y, 0, 'ripple');
      spawnRipple(x, y, 220, 'ripple');
      spawnRipple(x, y, 440, 'ripple');
    });
  }
</script>
