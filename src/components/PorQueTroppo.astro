---
// Sección 4 rúbrica — "Por qué Troppo es mejor que sus competidores"
//
// Concepto visual: el ciclo completo Simular → Analizar → Optimizar con IA
// → Monitorear y operar en tiempo real, con etiquetas neutrales que separan
// las etapas (simulación y análisis / optimización y operación).

const pasos = [
  {
    num: '01',
    titulo: 'Simular para probar',
    desc: 'La red vial se representa en una simulación para evaluar distintos escenarios de forma virtual, sin realizar cambios en la infraestructura existente.',
    troppoOnly: false,
    icon: 'test',
  },
  {
    num: '02',
    titulo: 'Analizar',
    desc: 'Puedes comparar los resultados de cada ejecución: espera, flujo, emisiones y distribución de vehículos.',
    troppoOnly: false,
    icon: 'chart',
  },
  {
    num: '03',
    titulo: 'Optimizar con IA',
    desc: 'Con aprendizaje por refuerzo, la IA evalúa alternativas y recomienda ubicaciones de semáforos que contribuyan a reducir la congestión.',
    troppoOnly: true,
    icon: 'ai',
  },
  {
    num: '04',
    titulo: 'Monitorear y operar en vivo',
    desc: 'El gemelo digital permite monitorear el estado de la red vial en tiempo real e intervenir en la operación semafórica cuando las condiciones del tránsito lo requieren.',
    troppoOnly: true,
    icon: 'radar',
  },
];
---

<section class="porque sec-light" id="porque-troppo">
  <div class="wrap">
    <header class="porque-head">
      <div class="porque-eyebrow sec-title" data-vh>
        ¿Por qué Troppo?
      </div>
      <h2 class="sec-subtitle" data-vh>Todo el proceso, <em>en una sola plataforma.</em></h2>
      <p data-vh>
        Troppo integra en una sola plataforma las distintas etapas de gestión de
        la red vial: simular escenarios para evaluar alternativas,
        <strong>optimizar con IA</strong>, decidir con evidencia y
        <strong>monitorear y operar en tiempo real</strong>.
      </p>
    </header>

    <div class="porque-flow" role="list">
      {/* Etiquetas de grupo — sólo visibles en desktop. En mobile se
          usan los badges per-card + el label absoluto sobre la flecha. */}
      <div class="pq-group-label pq-group-regular" aria-hidden="true">
        <span class="pq-group-line"></span>
        <span class="pq-group-chip">Simulación y análisis</span>
        <span class="pq-group-line"></span>
      </div>
      <div class="pq-group-label pq-group-troppo" aria-hidden="true">
        <span class="pq-group-line"></span>
        <span class="pq-group-chip">Optimización y operación</span>
        <span class="pq-group-line"></span>
      </div>
      {
        pasos.map((p, i) => (
          <>
            <article class={`pq-step pq-step--${p.icon} ${p.troppoOnly ? 'is-troppo' : ''}`} data-reveal data-c={i} role="listitem">
              <div class="pq-step-head">
                <span class="pq-num">{p.num}</span>
                {p.troppoOnly && <span class="pq-badge">Optimización y operación</span>}
              </div>
              <div class="pq-icon-wrap">
                <svg class="pq-icon" viewBox="0 0 32 32" aria-hidden="true">
                  {p.icon === 'test' && (
                    <>
                      <rect x="6" y="6" width="20" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
                      <path d="M6 12 L26 12 M6 20 L26 20 M12 6 L12 26 M20 6 L20 26" stroke="currentColor" stroke-width="1" opacity="0.35" />
                      {/* Dots ancla + probe pulses en distintas intersecciones */}
                      <circle cx="12" cy="12" r="1.4" fill="currentColor" opacity="0.5" />
                      <circle cx="20" cy="20" r="1.4" fill="currentColor" opacity="0.5" />
                      <circle class="pq-probe pq-probe-1" cx="20" cy="12" r="2.2" fill="currentColor" />
                      <circle class="pq-probe pq-probe-2" cx="12" cy="20" r="2.2" fill="currentColor" />
                      <circle class="pq-probe pq-probe-3" cx="16" cy="16" r="2.2" fill="currentColor" />
                    </>
                  )}
                  {p.icon === 'chart' && (
                    <>
                      <path d="M5 27 L5 6 M5 27 L27 27" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                      <path d="M8 22 L14 17 L19 20 L24 11" stroke="currentColor" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                      {/* Scan vertical + data points pulsantes en secuencia */}
                      <rect class="pq-scan" x="5" y="6" width="0.9" height="21" fill="currentColor" opacity="0.75" rx="0.4" />
                      <circle class="pq-dp pq-dp-1" cx="14" cy="17" r="1.6" fill="currentColor" />
                      <circle class="pq-dp pq-dp-2" cx="19" cy="20" r="1.6" fill="currentColor" />
                      <circle class="pq-dp pq-dp-3" cx="24" cy="11" r="1.6" fill="currentColor" />
                    </>
                  )}
                  {p.icon === 'ai' && (
                    <>
                      <circle cx="6" cy="10" r="2.2" fill="currentColor" />
                      <circle cx="26" cy="10" r="2.2" fill="currentColor" />
                      <circle cx="7" cy="23" r="2.2" fill="currentColor" />
                      <circle cx="25" cy="23" r="2.2" fill="currentColor" />
                      <line x1="6" y1="10" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      <line x1="26" y1="10" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      <line x1="7" y1="23" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      <line x1="25" y1="23" x2="16" y2="16" stroke="currentColor" stroke-width="1.2" opacity="0.7" />
                      {/* Núcleo pulsante + sinapsis viajando desde cada nodo hacia el centro */}
                      <circle class="pq-brain" cx="16" cy="16" r="3.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-1" cx="6" cy="10" r="1.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-2" cx="26" cy="10" r="1.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-3" cx="7" cy="23" r="1.2" fill="currentColor" />
                      <circle class="pq-syn pq-syn-4" cx="25" cy="23" r="1.2" fill="currentColor" />
                    </>
                  )}
                  {p.icon === 'radar' && (
                    <>
                      <circle cx="16" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35" />
                      <circle cx="16" cy="16" r="6" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5" />
                      <circle cx="16" cy="16" r="2.4" fill="currentColor" />
                      {/* Sonar rings expandiéndose desde el centro */}
                      <circle class="pq-sonar pq-sonar-1" cx="16" cy="16" r="4" fill="none" stroke="currentColor" stroke-width="0.9" vector-effect="non-scaling-stroke" />
                      <circle class="pq-sonar pq-sonar-2" cx="16" cy="16" r="4" fill="none" stroke="currentColor" stroke-width="0.9" vector-effect="non-scaling-stroke" />
                      {/* Brazo del radar rotando alrededor del centro */}
                      <g class="pq-arm">
                        <line x1="16" y1="16" x2="24" y2="10" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        <circle cx="24" cy="10" r="1.6" fill="currentColor" />
                      </g>
                    </>
                  )}
                </svg>
              </div>
              <h3>{p.titulo}</h3>
              <p>{p.desc}</p>
            </article>

            {i < pasos.length - 1 && (
              <div class="pq-arrow" data-a={i} aria-hidden="true">
                <svg viewBox="0 0 32 12" width="28" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 6 L26 6" />
                  <path d="M20 2 L26 6 L20 10" />
                </svg>
                {i === 1 && (
                  <span class="pq-arrow-label pq-badge">Simulación y análisis</span>
                )}
              </div>
            )}
          </>
        ))
      }
    </div>

    <!-- Highlight final — parafraseo del rúbrica -->
    <div class="pq-highlight">
      <p>
        <strong>Troppo</strong> permite analizar la red vial mediante simulaciones,
        evaluar alternativas con IA y <em>llevar las decisiones a la operación
        real</em>, con monitoreo y capacidad de intervención en tiempo real
        mediante el gemelo digital.
      </p>
    </div>
  </div>
</section>

<style>
  .porque {
    padding: 110px 0 130px;
    background: rgba(255, 248, 234, 0.72);
    position: relative;
    overflow: hidden;
  }
  .wrap { position: relative; z-index: 1; }

  /* ---- HEAD ---- */
  .porque-head {
    max-width: 720px;
    margin: 0 auto 64px;
    text-align: center;
  }
  .porque-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 24px;
  }
  .porque-head h2 {
    margin: 0;
  }
  .porque-head p {
    margin: 22px auto 0;
    font-size: 16px;
    line-height: 1.65;
    color: rgba(21, 27, 32, 0.78);
    max-width: 580px;
    /* Gradient cyan sutil → blanco + barra cyan-ink (oscuro) gruesa
       ARRIBA como acento distintivo del bloque. */
    padding: 22px 26px;
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-top: 4px solid var(--cyan-ink);
    border-radius: 4px 4px 20px 20px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    text-align: left;
  }
  .porque-head strong {
    color: var(--navy);
    font-weight: 700;
  }
  /* Reveal escalonado del header */
  .porque [data-vh] {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .porque [data-vh].revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ---- FLOW (4 pasos + 3 arrows entre ellos) ---- */
  .porque-flow {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    gap: 0;
    align-items: stretch;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* --- Etiquetas de grupo (DESKTOP) ---
     'Simulación y análisis' arriba de pasos 01–02.
     'Optimización y operación' arriba de pasos 03–04.
     En mobile quedan ocultas — se usan los badges per-card + label
     de la flecha límite (comportamiento previo). */
  .pq-group-label { display: none; }
  @media (min-width: 961px) {
    .porque-flow {
      grid-template-rows: auto 1fr;
      row-gap: 26px;
    }
    /* Ambas etiquetas ("Simulación y análisis" y "Optimización y
       operación") comparten el mismo diseño; sólo cambia su columna. */
    .pq-group-label {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 8px;
      grid-row: 1;
      color: var(--cyan-ink);
    }
    .pq-group-regular {
      grid-column: 1 / 4;
    }
    .pq-group-troppo {
      grid-column: 5 / 8;
    }
    .pq-group-line {
      flex: 1;
      height: 1px;
      background: currentColor;
      opacity: 0.4;
    }
    .pq-group-chip {
      padding: 6px 14px;
      font-family: var(--font-sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      border: 1px solid currentColor;
      border-radius: 100px;
      background: rgba(255, 255, 255, 0.92);
      white-space: nowrap;
    }
    /* Colocación explícita de cards y arrows en row 2 */
    .porque-flow [data-c="0"] { grid-column: 1; grid-row: 2; }
    .porque-flow [data-a="0"] { grid-column: 2; grid-row: 2; }
    .porque-flow [data-c="1"] { grid-column: 3; grid-row: 2; }
    .porque-flow [data-a="1"] { grid-column: 4; grid-row: 2; }
    .porque-flow [data-c="2"] { grid-column: 5; grid-row: 2; }
    .porque-flow [data-a="2"] { grid-column: 6; grid-row: 2; }
    .porque-flow [data-c="3"] { grid-column: 7; grid-row: 2; }
    /* En desktop escondemos los indicadores per-card — la información
       vive en las etiquetas de grupo arriba. */
    .porque-flow .pq-badge { display: none; }
    .porque-flow .pq-arrow-label { display: none; }
    .pq-step-head { min-height: 0; }
  }

  /* Card de paso — regular (Probar / Analizar).
     Gradient cyan sutil → blanco (mismo lenguaje que las cards de
     Misión / Visión) para que se sientan sólidas y legibles. */
  .pq-step {
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.06), #fff);
    border: 1px solid rgba(4, 69, 89, 0.14);
    border-radius: 16px;
    padding: 26px 24px 28px;
    display: flex;
    flex-direction: column;
    text-align: center;
    color: var(--navy);
    transition:
      transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 350ms ease,
      border-color 350ms ease,
      background 350ms ease;
    position: relative;
    overflow: hidden;
  }
  /* Contenido en su propia capa dentro de la card */
  .pq-step-head,
  .pq-step .pq-icon-wrap,
  .pq-step h3,
  .pq-step p {
    position: relative;
    z-index: 1;
  }
  .pq-step:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(4, 69, 89, 0.14);
    border-color: rgba(4, 69, 89, 0.28);
  }

  /* Estilos especiales para pasos "Sólo Troppo" — fondo navy oscuro
     (mismo tono que el panel 'Flujo Principal' de FlujoParalelo)
     con border y glow lime que los hace destacar. */
  .pq-step.is-troppo {
    /* Gradient navy oscuro: más denso arriba, respira hacia abajo. */
    background: linear-gradient(180deg, rgba(4, 69, 89, 0.92), rgba(4, 69, 89, 0.66));
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-color: rgba(209, 235, 120, 0.55);
    box-shadow:
      0 0 0 1px rgba(209, 235, 120, 0.32),
      0 6px 22px rgba(209, 235, 120, 0.18);
    color: var(--cream);
  }
  .pq-step.is-troppo:hover {
    background: linear-gradient(180deg, rgba(4, 69, 89, 0.96), rgba(4, 69, 89, 0.78));
    border-color: var(--lime);
    box-shadow:
      0 0 0 2px rgba(209, 235, 120, 0.45),
      0 14px 34px rgba(209, 235, 120, 0.32);
  }
  /* Adaptar los textos internos al fondo navy oscuro */
  .pq-step.is-troppo .pq-num { color: var(--cyan); }
  .pq-step.is-troppo h3 { color: var(--cream); }
  .pq-step.is-troppo p { color: rgba(255, 248, 234, 0.82); }

  .pq-step-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
    min-height: 24px;
  }
  .pq-num {
    font-family: var(--font-title);
    font-size: 24px;
    color: var(--cyan-ink);
    font-weight: 700;
    line-height: 1;
  }
  .pq-badge {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 1.2px;
    padding: 4px 8px;
    background: var(--cyan);
    color: var(--navy-deep);
    border-radius: 100px;
    text-transform: uppercase;
  }

  /* Icono central en su chip */
  .pq-icon-wrap {
    width: 60px;
    height: 60px;
    margin: 4px auto 18px;
    border-radius: 14px;
    background: rgba(97, 225, 230, 0.12);
    border: 1px solid rgba(97, 225, 230, 0.28);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--navy);
  }
  .pq-step.is-troppo .pq-icon-wrap {
    background: rgba(97, 225, 230, 0.16);
    border-color: rgba(97, 225, 230, 0.45);
    color: var(--cyan);
  }
  .pq-icon { width: 32px; height: 32px; }

  .pq-step h3 {
    font-family: var(--font-title);
    font-size: 17px;
    font-weight: 700;
    color: var(--navy);
    margin: 0 0 8px;
  }
  .pq-step p {
    font-size: 13.5px;
    line-height: 1.55;
    color: rgba(21, 27, 32, 0.72);
    margin: 0;
  }

  /* Arrows entre pasos */
  .pq-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
    color: rgba(4, 69, 89, 0.35);
    position: relative;
  }
  /* Etiqueta sobre la flecha límite (sólo visible en mobile). Su
     aspecto lo da .pq-badge, igual que "Optimización y operación";
     aquí sólo queda la posición. */
  .pq-arrow-label {
    position: absolute;
    top: -32px;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  /* Highlight final */
  .pq-highlight {
    max-width: 780px;
    margin: 68px auto 0;
    padding: 30px 40px;
    /* Mismo tratamiento que las cards de Misión / Visión y el resto de
       bloques descriptivos: gradient cyan sutil → blanco, border cyan
       alrededor, esquinas redondeadas, sombra suave. */
    background: linear-gradient(180deg, rgba(97, 225, 230, 0.05), #fff);
    border: 1px solid rgba(97, 225, 230, 0.28);
    border-radius: 20px;
    box-shadow: 0 10px 28px rgba(4, 69, 89, 0.06);
    text-align: left;
  }
  .pq-highlight p {
    font-family: var(--font-sans);
    font-size: 18px;
    line-height: 1.55;
    color: var(--navy);
    margin: 0;
    font-weight: 500;
  }
  .pq-highlight strong {
    font-family: var(--font-sans);
    font-weight: 700;
    color: var(--navy);
  }
  .pq-highlight em {
    font-family: var(--font-sans);
    font-style: italic;
    color: var(--cyan-ink);
    font-weight: 500;
  }

  /* Reveal on scroll */
  .pq-step {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 700ms ease,
      transform 700ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 350ms ease,
      border-color 350ms ease,
      background 350ms ease;
  }
  .pq-step.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============ ANIMACIONES POR ICONO ============
     Cada card tiene una animación temática que refuerza su título.
     Uso CSS animations (respetan prefers-reduced-motion) sobre elementos
     SVG con transform-box para centrar el origen correctamente. */

  /* --- 1. PROBAR — dots que aparecen y desaparecen como toques de prueba --- */
  @keyframes pq-probe-pulse {
    0%, 100% { transform: scale(0); opacity: 0; }
    35%      { transform: scale(1); opacity: 1; }
    75%      { transform: scale(1.4); opacity: 0.25; }
  }
  .pq-probe {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-probe-pulse 2.1s ease-out infinite;
  }
  .pq-probe-2 { animation-delay: 0.7s; }
  .pq-probe-3 { animation-delay: 1.4s; }

  /* --- 2. ANALIZAR — scan vertical + data points pulsantes en secuencia --- */
  @keyframes pq-scan-move {
    0%   { transform: translateX(0); opacity: 0.75; }
    88%  { transform: translateX(19px); opacity: 0.75; }
    100% { transform: translateX(19px); opacity: 0; }
  }
  .pq-scan {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-scan-move 2.4s ease-in-out infinite;
  }
  @keyframes pq-datapoint {
    0%, 55%, 100% { transform: scale(1); }
    65%, 80%      { transform: scale(1.55); }
  }
  .pq-dp {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-datapoint 2.4s ease-in-out infinite;
  }
  .pq-dp-2 { animation-delay: 0.5s; }
  .pq-dp-3 { animation-delay: 1.0s; }

  /* --- 3. OPTIMIZAR CON IA — núcleo pulsante + sinapsis fluyendo al centro --- */
  @keyframes pq-brain-pulse {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.22); }
  }
  .pq-brain {
    transform-box: fill-box;
    transform-origin: center;
    animation: pq-brain-pulse 1.6s ease-in-out infinite;
  }
  .pq-syn {
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Deltas de cada nodo esquina hacia (16,16):
     (6,10)  → +10,+6    (26,10) → -10,+6
     (7,23)  → +9,-7     (25,23) → -9,-7 */
  @keyframes pq-syn-1 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(10px, 6px); opacity: 0; }
  }
  @keyframes pq-syn-2 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-10px, 6px); opacity: 0; }
  }
  @keyframes pq-syn-3 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(9px, -7px); opacity: 0; }
  }
  @keyframes pq-syn-4 {
    0%   { transform: translate(0,0); opacity: 0; }
    15%  { opacity: 1; }
    85%  { opacity: 1; }
    100% { transform: translate(-9px, -7px); opacity: 0; }
  }
  .pq-syn-1 { animation: pq-syn-1 1.8s linear infinite 0s; }
  .pq-syn-2 { animation: pq-syn-2 1.8s linear infinite 0.45s; }
  .pq-syn-3 { animation: pq-syn-3 1.8s linear infinite 0.9s; }
  .pq-syn-4 { animation: pq-syn-4 1.8s linear infinite 1.35s; }

  /* --- 4. MONITOREAR EN VIVO — radar arm rotando + sonar pulses --- */
  @keyframes pq-arm-rot {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }
  .pq-arm {
    transform-box: view-box;
    transform-origin: 16px 16px;
    animation: pq-arm-rot 3.2s linear infinite;
  }
  @keyframes pq-sonar-pulse {
    0%   { transform: scale(0.35); opacity: 0.9; }
    100% { transform: scale(2.1); opacity: 0; }
  }
  .pq-sonar {
    transform-box: view-box;
    transform-origin: 16px 16px;
    animation: pq-sonar-pulse 2s ease-out infinite;
  }
  .pq-sonar-2 { animation-delay: 1s; }

  /* --- MOBILE --- */
  @media (max-width: 960px) {
    .porque-flow {
      grid-template-columns: 1fr;
      gap: 16px;
      max-width: 480px;
    }
    /* Ya no rotamos el contenedor de la flecha entero: sólo el SVG.
       Así la etiqueta puede quedar centrada arriba sin salirse ni
       montarse sobre la card siguiente. */
    .pq-arrow {
      transform: none;
      flex-direction: column;
      gap: 6px;
      padding: 4px 0;
    }
    .pq-arrow svg {
      transform: rotate(90deg);
    }
    .pq-arrow-label {
      position: static;
      transform: none;
      top: auto;
      left: auto;
      white-space: normal;
      max-width: 260px;
      text-align: center;
    }
    .pq-highlight {
      padding: 24px 26px;
      margin-top: 48px;
    }
    .pq-highlight p { font-size: 16px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pq-step {
      opacity: 1;
      transform: none;
      transition: none;
    }
    /* Detenemos todas las animaciones temáticas por icono */
    .pq-probe, .pq-scan, .pq-dp, .pq-brain, .pq-syn, .pq-arm, .pq-sonar {
      animation: none;
    }
    /* Ocultamos elementos que sólo tienen sentido animándose */
    .pq-probe, .pq-scan, .pq-syn, .pq-sonar { display: none; }
  }
</style>

<script>
  import { revealOnScroll } from '../scripts/reveal';
  // Reveal escalonado — se re-anima cada vez que los steps vuelven al
  // viewport. Trackeamos el timeout por elemento para cancelarlo si
  // salen antes de completar el reveal.
  const steps = document.querySelectorAll<HTMLElement>('.porque .pq-step');
  if (steps.length) {
    // Histéresis: salida 48px sobre la pantalla (> 24px del translateY
    // oculto) para que la tarjeta no vuelva a entrar al ocultarse.
    revealOnScroll(steps, {
      enterMargin: '0px 0px -15% 0px',
      threshold: 0.2,
      exitMargin: '48px 0px -15% 0px',
      staggerMs: 120,
    });
  }

  // Reveal escalonado del header (eyebrow → h2 → párrafo). Re-animatable.
  const porqueHeadItems = Array.from(
    document.querySelectorAll<HTMLElement>('.porque [data-vh]'),
  );
  if (porqueHeadItems.length) {
    porqueHeadItems.forEach((el, i) => {
      el.style.transitionDelay = `${i * 140}ms`;
    });
    // Histéresis: salida 28px sobre la pantalla (> 14px del translateY
    // oculto) para que el encabezado no vuelva a entrar al ocultarse.
    revealOnScroll(porqueHeadItems, {
      enterMargin: '0px 0px -10% 0px',
      threshold: 0.2,
      exitMargin: '28px 0px -10% 0px',
    });
  }
</script>
